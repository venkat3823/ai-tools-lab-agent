{
  "manifest_version": 3,
  "name": "AI Tools Lab Agent",
  "version": "1.0",
  "description": "On-screen side panel assistant for the 25 B.Tech AI Tools Lab exercises.",
  "permissions": ["sidePanel", "activeTab", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AI Lab Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}